# --- Byte-compiled / caches ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/
.env

# --- Dataset & generated data (do NOT commit) ---
# Raw MATLAB recordings, partial downloads and processed arrays.
*.mat
*.part
*.npz
data/interim/*
!data/interim/.gitkeep

# --- Heavy generated result artifacts (regenerated by the notebooks) ---
*.pt
*.ckpt
*.joblib
*.parquet
results/**/figures/*.png
results/**/figures/*.pdf
results/**/figures/*.svg
results/**/logs/*.log

# Keep lightweight schema / config / report files and directory markers.
# manifests (*.csv) and metadata (*.json) ARE intentionally tracked.
!**/.gitkeep

# --- OS junk ---
.DS_Store
Thumbs.db
